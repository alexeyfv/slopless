{
  "name": "slopless",
  "description": "Keep your music free of AI slop.",
  "private": true,
  "license": "MIT",
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "lint": "pnpm check"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "prettier": "^3.9.6",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "wxt": "^0.21.3"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.9.0",
      "tmp": ">=0.2.6",
      "adm-zip": ">=0.6.0",
      "esbuild": ">=0.28.1"
    }
  },
  "dependencies": {
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/storage": "^2.0.0",
    "lru-cache": "11.5.2",
    "tailwindcss": "^4.3.3"
  }
}
