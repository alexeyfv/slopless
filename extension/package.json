    "svelte": "^5.55.8",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@tabler/icons-svelte": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@webext-core/messaging": "^2.3.0",
