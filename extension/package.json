{
  "name": "slopless",
  "description": "Keep your music free of AI slop.",
  "private": true,
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
