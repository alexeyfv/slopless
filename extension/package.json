    "@wxt-dev/module-svelte": "^2.0.4",
    "prettier": "^3.8.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "swagger-typescript-api": "^13.6.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@tabler/icons-svelte": "^3.41.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/query-core": "^5.91.2",
    "@tanstack/svelte-query": "^6.1.3",
    "@webext-core/job-scheduler": "^1.0.0",
